{
  "name": "rig-commander",
  "version": "3.12.0",
  "description": "Mission Control & Neural Command Deck for Autonomous AI Engineering Fleets",
  "type": "module",
  "main": "openrig/server.mjs",
  "files": [
    "bin/",
    "openrig/",
    "!openrig/docs/**",
    "docs/USER_GUIDE.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "rig-commander": "bin/cli.mjs",
    "rig-cmd": "bin/cli.mjs"
  },
  "scripts": {
    "start": "node bin/cli.mjs",
    "deck": "node openrig/server.mjs",
    "sync:public": "node scripts/sync-public.mjs",
    "audit:exposure": "node scripts/audit-exposure.mjs",
    "verify:providers": "node scripts/verify-providers.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "ai-agents",
    "agentic-workflows",
    "orchestration",
    "mission-control",
    "command-deck",
    "tmux",
    "telemetry",
    "multi-agent",
    "finops",
    "sa-dss"
  ],
  "author": "RigCommander Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vedariy/rig-commander.git"
  },
  "bugs": {
    "url": "https://github.com/Vedariy/rig-commander/issues"
  },
  "homepage": "https://github.com/Vedariy/rig-commander#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}
