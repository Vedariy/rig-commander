            "members": "object"
          }
        },
        "swarmMemberEntry": {
          "required": ["phase|desired_state", "wake_mode"],
          "types": {
            "wake_mode": "string"
          }
        },
        "swarmPlan": {
          "required": ["goal|tasks|threads"]
        },
        "swarmBoardEntry": {
          "required": ["seq", "agent", "text"],
          "types": {
            "seq": "number",
            "agent": "string",
            "text": "string"
          }
        }
      }
    }
